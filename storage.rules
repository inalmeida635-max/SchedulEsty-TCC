rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: qualquer pessoa logada pode ver,
    // só o dono da conta pode enviar/trocar a própria foto.
    match /perfis/{uid}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Imagens de serviços: visíveis a todos, só o profissional dono
    // do serviço pode enviar.
    match /servicos/{uid}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
